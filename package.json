{
  "name": "node-darts",
  "version": "1.1.0",
  "description": "Darts (Double-ARray Trie System) for Node.js, compiled to WebAssembly",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "yarn clean && yarn build:wasm && tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/postbuild-copy.cjs",
    "clean": "rimraf dist",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage",
    "prepare": "yarn build",
    "prepublishOnly": "yarn clean && yarn ci && yarn build && yarn test",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "darts",
    "darts-clone",
    "trie",
    "double-array",
    "dictionary",
    "search",
    "wasm",
    "webassembly"
  ],
  "author": "libraz <libraz@libraz.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/libraz/node-darts.git"
  },
  "bugs": {
    "url": "https://github.com/libraz/node-darts/issues"
  },
  "homepage": "https://github.com/libraz/node-darts#readme",
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "yarn lint-staged"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{js,cjs,mjs,ts}": [
      "vitest run --changed"
    ],
    "package.json": [
      "bash -c \"yarn test:coverage:check\""
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "lint-staged": "^17.6.0",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "packageManager": "yarn@4.18.0"
}
